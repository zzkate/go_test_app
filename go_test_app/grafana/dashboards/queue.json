{
  "uid": "queue-broker",
  "title": "Queue broker",
  "tags": ["queue"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Запросы в секунду",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(queue_put_total[1m])", "legendFormat": "put" },
        { "refId": "B", "expr": "rate(queue_get_total[1m])", "legendFormat": "get" },
        { "refId": "C", "expr": "rate(queue_get_miss_total[1m])", "legendFormat": "404" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Глубина очередей",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "queue_depth", "legendFormat": "{{queue}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ожидающие получатели",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "queue_waiters", "legendFormat": "{{queue}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Таймауты ожидания в секунду",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(queue_wait_timeout_total[1m])" }
      ]
    }
  ]
}
